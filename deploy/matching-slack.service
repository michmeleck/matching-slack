[Unit]
Description=matching-slack bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=matching-slack
WorkingDirectory=/opt/matching-slack
EnvironmentFile=/opt/matching-slack/.env
ExecStart=/usr/bin/node /opt/matching-slack/dist/index.js
Restart=on-failure
RestartSec=5
# Hardening (safe defaults for a small single-purpose service)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
