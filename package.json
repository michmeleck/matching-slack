{
  "name": "matching-slack",
  "version": "1.0.0",
  "description": "Slack bot: validates uploaded creator CSVs and files a Linear ticket on success",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@linear/sdk": "^92.0.0",
    "@slack/bolt": "^3.19.0",
    "dotenv": "^16.4.5",
    "papaparse": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/papaparse": "^5.3.14",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
